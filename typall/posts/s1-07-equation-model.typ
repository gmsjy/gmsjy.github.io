// s1-07-equation-model.typ — 第一季 07：方程、不等式与建模
#import "../assets/series-figures/s1-fig-07-equation.typ": fig as fig-intersect
#import "../assets/series-figures/s1-fig-07b-interval.typ": fig as fig-interval
