// s1-12-electromagnetism.typ — 第一季 12：电与磁：从电路到场
#import "../assets/series-figures/s1-fig-12-electromagnetism.typ": fig as fig-circuit
#import "../assets/series-figures/s1-fig-12b-field.typ": fig as fig-field
