// s2-09-dynamics.typ — 第二季 09：动力学综合：连接体、临界、板块与传送带
#import "../assets/series-figures/s2-fig-09-dynamics.typ": fig as fig-plank
#import "../assets/series-figures/s2-fig-09b-belt.typ": fig as fig-belt
